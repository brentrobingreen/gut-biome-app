<section class="icon-box-section" style="background-color: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width icon-box-wrapper" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; text-align: center;">
    {% for block in section.blocks %}
      <div class="icon-box" style="flex: 1 1 {{ 100 | divided_by: section.settings.columns }}%; min-width: 150px;">
        {% if block.settings.icon_image != blank %}
          <div class="icon-box__icon">
            <img src="{{ block.settings.icon_image | image_url: width: 64 }}" alt="" style="height: 40px; margin: 0 auto;">
          </div>
        {% elsif block.settings.icon_svg != blank %}
          <div class="icon-box__icon" style="font-size: 40px; margin-bottom: 8px;">
            {{ block.settings.icon_svg }}
          </div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <h3 style="font-weight: bold; font-size: 16px; margin: 10px 0 4px;">{{ block.settings.heading }}</h3>
        {% endif %}
        {% if block.settings.subtext != blank %}
          <p style="font-size: 14px; margin: 0;">{{ block.settings.subtext }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Icon Box",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e5ff2e"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Icons per row (desktop)",
      "min": 1,
      "max": 4,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Custom SVG (optional)",
          "info": "Overrides uploaded image if present"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "On all orders within Australia"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Icon Box",
      "blocks": [
        {
          "type": "icon",
          "settings": {
            "heading": "Free Shipping",
            "subtext": "On all orders within Australia"
          }
        },
        {
          "type": "icon",
          "settings": {
            "heading": "Flexible Payment",
            "subtext": "Multiple methods of payment"
          }
        },
        {
          "type": "icon",
          "settings": {
            "heading": "30 Day Return Policy",
            "subtext": "Return within 30 days for a refund"
          }
        }
      ]
    }
  ]
}
{% endschema %}
