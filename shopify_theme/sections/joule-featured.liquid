{% comment %}
  Joule Featured Collection Section — original markup/restored hover
{% endcomment %}

<section
  class="joule-featured-section"
  style="--section-text: {{ section.settings.text_color | default: '#000035' }}; color: var(--section-text);">
  <div class="joule-featured__inner page-width">

    <div
      class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      style="text-align: {{ section.settings.heading_alignment }};"
    >
      {%- if section.settings.caption != blank -%}
        <p class="caption-with-letter-spacing" style="font-size: {{ section.settings.caption_size }}px;">
          {{ section.settings.caption | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="collapsible-content__heading inline-richtext" style="font-size: {{ section.settings.heading_size }}px;">
          {{ section.settings.heading }}
        </h2>
      {%- else -%}
        <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
      {%- endif %}
    </div>

    <!-- Added unique ID for dots JS -->
    <div class="joule-featured__grid" id="jf-grid-{{ section.id }}">
      {% assign collection = section.settings.collection %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        {% assign hover_color = product.metafields.custom.hover_color.value %}
        {% assign hover_gradient = product.metafields.custom.hover_gradient.value %}
        {% assign badge = product.metafields.custom.badge.value %}
        {% assign button_color = product.metafields.custom.button_color.value %}

        <div class="joule-featured__card" style="
          {% if hover_gradient %}
            --hover-bg: {{ hover_gradient }};
          {% elsif hover_color %}
            --hover-bg: {{ hover_color }};
          {% endif %}
        ">
          <a href="{{ product.url }}" class="joule-featured__image-wrapper">
            <img src="{{ product.featured_image | img_url: '540x' }}" alt="{{ product.title }}" class="product-image main-image" loading="lazy" decoding="async">
            {% if product.images.size > 1 %}
              <img src="{{ product.images[1] | img_url: '540x' }}" alt="{{ product.title }} Hover" class="product-image hover-image" loading="lazy" decoding="async">
            {% endif %}
          </a>

          {% if badge %}
            <div class="joule-featured__badge"
                style="background-color: {{ section.settings.badge_color }}; color: #ffffff !important;">
              {{ badge }}
            </div>
          {% endif %}

          <div class="joule-featured__content">
            <h3 class="joule-featured__title-text">{{ product.title }}</h3>
            <div class="joule-featured__price">{{ product.price | money }}</div>

            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.variants.first.id }}">
              <button
                type="submit"
                class="joule-featured__btn"
                style="--btn-bg: {{ button_color | default: section.settings.section_button_color }};">
                ADD TO CART
              </button>
            </form>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Dots (mobile only) -->
    <div class="joule-featured__dots only-mobile" id="jf-dots-{{ section.id }}">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <button class="joule-featured__dot" aria-label="Go to {{ product.title }}"></button>
      {% endfor %}
    </div>

  </div>
</section>

<style>
html, body { overflow-x: hidden; }

.joule-featured-section{
  padding: 40px 0;
  overflow-x: clip;
  position: relative;
}
.joule-featured__inner.page-width{
  overflow-x: clip;
}

/* ===== Ensure ALL section text follows the schema color ===== */
.joule-featured-section .collapsible-content__header,
.joule-featured-section .collapsible-content__heading,
.joule-featured-section .caption-with-letter-spacing,
.joule-featured-section .joule-featured__title-text,
.joule-featured-section .joule-featured__price {
  color: var(--section-text) !important;
}

.joule-featured-section .joule-featured__btn::before,
.joule-featured-section .joule-featured__btn::after {
  background: transparent !important;
}

/* Keep button label readable (don’t inherit the section color) */
.joule-featured-section .joule-featured__btn {
  color: #fff !important;
}

/* Force button and any overlay to use the selected background */
.joule-featured-section .joule-featured__btn,
.joule-featured-section .joule-featured__btn::before,
.joule-featured-section .joule-featured__btn::after {
  background: var(--btn-bg) !important;
  background-color: var(--btn-bg) !important;
  border-color: transparent !important;
}

/* =========================
   MOBILE (≤ 749px)
   ========================= */
@media (max-width: 749px) {
  /* Comfortable side padding for heading/subheading */
  .joule-featured-section .collapsible-content__header {
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 12px;
  }

  .collapsible-content__header .collapsible-content__heading.inline-richtext {
    font-size: clamp(28px, 8.2vw, 36px) !important;
    line-height: 1.12 !important;
    word-break: break-word;
  }
  .collapsible-content__header .caption-with-letter-spacing {
    font-size: clamp(14px, 4.3vw, 16px) !important;
    line-height: 1.45 !important;
    opacity: 1 !important;
  }

  /* Compact vertical spacing */
  .joule-featured-section {
    padding-top: 24px;
    padding-bottom: 24px;
  }

  /* Product grid layout */
  .joule-featured-section .joule-featured__grid {
    display: flex !important;
    gap: 12px !important;
    overflow-x: auto !important;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    padding: 8px 20px 14px 20px !important;
    scroll-padding-left: 20px;
    scroll-padding-right: 20px;
  }

  /* Each card: static, no movement, no hover lift */
  .joule-featured__card {
    flex: 0 0 88% !important;
    max-width: 88% !important;
    scroll-snap-align: start;
    transition: none !important;
    transform: none !important;
    margin-top: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .joule-featured__card:hover,
  .joule-featured__card:focus,
  .joule-featured__card:active,
  .joule-featured__card:focus-within {
    transform: none !important;
    margin-top: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* === Image wrapper cleanup === */
  .joule-featured__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    overflow: hidden;
    background: transparent !important; /* remove background edge flicker */
  }

  .joule-featured__image-wrapper img {
    width: 100%;
    height: auto;
    display: block;               
    object-fit: cover;
    border: none !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
    vertical-align: middle !important; 
    background: transparent !important;
  }

  /* Hide hover image fully unless used */
  .joule-featured__image-wrapper img.hover-image {
    opacity: 0;
    pointer-events: none;
  }

  /* Hide scrollbar */
  .joule-featured__grid::-webkit-scrollbar { display: none; }
  .joule-featured__grid { -ms-overflow-style: none; scrollbar-width: none; }

  /* Dots */
  .joule-featured__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 4px auto 0;
    width: max-content;
  }
  .joule-featured__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #cfd3d9; border: 0; padding: 0;
    transition: transform .15s ease, background .15s ease;
  }
  .joule-featured__dot.is-active { background: #000; transform: scale(1.3); }
  .joule-featured__dot:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
}
/* ==== HARD FIX: remove the tiny top line on product images (mobile) ==== */
@media (max-width: 749px) {
  .joule-featured-section .joule-featured__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    line-height: 0 !important;       
    padding: 0 !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 12px;              
    overflow: hidden;
    background: transparent !important;
  }

  .joule-featured-section .joule-featured__image-wrapper::before,
  .joule-featured-section .joule-featured__image-wrapper::after {
    content: none !important;
    display: none !important;
    border: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  .joule-featured-section .joule-featured__image-wrapper img {
    display: block !important;        
    width: 100% !important;
    height: auto !important;
    object-fit: cover !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    transform: translateZ(0);         
  }
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const grid = document.getElementById('jf-grid-{{ section.id }}');
  const dotsWrap = document.getElementById('jf-dots-{{ section.id }}');
  if (!grid || !dotsWrap) return;

  const cards = Array.from(grid.querySelectorAll('.joule-featured__card'));
  const dots  = Array.from(dotsWrap.querySelectorAll('.joule-featured__dot'));

  function setActive(i) {
    dots.forEach((d, idx) => d.classList.toggle('is-active', idx === i));
  }
  function nearestIndex() {
    const x = grid.scrollLeft;
    let bestIdx = 0;
    let bestDist = Infinity;
    cards.forEach((c, i) => {
      const dist = Math.abs(c.offsetLeft - x);
      if (dist < bestDist) { bestDist = dist; bestIdx = i; }
    });
    return bestIdx;
  }
  function scrollToCard(i) {
    const gLeft = grid.getBoundingClientRect().left;
    const cLeft = cards[i].getBoundingClientRect().left;
    const left = (cLeft - gLeft) + grid.scrollLeft;
    grid.scrollTo({ left, behavior: 'smooth' });
  }

  const onScroll = () => setActive(nearestIndex());
  grid.addEventListener('scroll', onScroll, { passive: true });

  dots.forEach((btn, i) => btn.addEventListener('click', () => scrollToCard(i)));

  onScroll();
});
</script>

{% schema %}
{
  "name": "Joule Featured",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text color",
      "default": "#000035"
    },
    {
      "type": "color",
      "id": "section_button_color",
      "label": "Add to Cart button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge background color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Answers to the questions you didn’t even know you had."
    },
    {
      "type": "range",
      "id": "caption_size",
      "label": "Caption font size (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HAPPY TO CLEAR THINGS UP"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (px)",
      "min": 12,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Joule Featured"
    }
  ]
}
{% endschema %}
