{% schema %}
{
  "name": "Joule Hero Section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EEDAF6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "helvetica_n4"
    },
    {
      "type": "color",
      "id": "primary_button_color",
      "label": "Primary button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "primary_button_text_color",
      "label": "Primary button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_color",
      "label": "Secondary button background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_button_text_color",
      "label": "Secondary button text color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (transparent PNG or SVG)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "meet JOULE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading",
      "default": "Expert-formulated with performance-backed ingredients to fuel your focus, power your workouts, and keep your edge sharp.*"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "JOULE ENERGY"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "SHOP ALL"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Joule Hero Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{%- comment -%} DESKTOP VIEW (unchanged markup) {%- endcomment -%}
<section class="joule-hero only-desktop {{ section.settings.color_scheme }}" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; font-family: {{ section.settings.body_font.stack }};">
  <div class="joule-hero__content">
    <h1 class="joule-heading" style="color: {{ section.settings.text_color }}; font-family: {{ section.settings.heading_font.stack }};">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtext }}</p>
    <div class="joule-hero__buttons">
      <a href="{{ section.settings.primary_button_link }}" class="joule-btn" style="background-color: {{ section.settings.primary_button_color }}; color: {{ section.settings.primary_button_text_color }};">{{ section.settings.primary_button_text }}</a>
      <a href="{{ section.settings.secondary_button_link }}" class="joule-btn joule-btn--secondary" style="background-color: {{ section.settings.secondary_button_color }}; color: {{ section.settings.secondary_button_text_color }}; border: 2px solid #000035;">{{ section.settings.secondary_button_text }}</a>
    </div>
  </div>
  <div class="joule-hero__image">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | image_url }}" alt="JOULE Gummies">
    {% endif %}
  </div>
</section>

{%- comment -%} MOBILE VIEW (new, purpose-built) {%- endcomment -%}
<section class="joule-hero-m only-mobile {{ section.settings.color_scheme }}" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }}; font-family: {{ section.settings.body_font.stack }};">
  <div class="joule-hero-m__inner m-pad-lg m-stack-lg">
    
    {% if section.settings.hero_image %}
      <div class="m-hero-img">
        <img src="{{ section.settings.hero_image | image_url }}" alt="JOULE Gummies" loading="eager" decoding="async">
      </div>
    {% endif %}

    <h1 class="m-type-h1 joule-hero-m__title" style="color: {{ section.settings.text_color }}; font-family: {{ section.settings.heading_font.stack }};">
      {{ section.settings.heading }}
    </h1>

    <p class="m-type-body joule-hero-m__sub">
      {{ section.settings.subtext }}
    </p>

    <div class="joule-hero-m__buttons m-stack">
      <a href="{{ section.settings.primary_button_link }}" class="joule-btn joule-btn--m tap-target" style="background-color: {{ section.settings.primary_button_color }}; color: {{ section.settings.primary_button_text_color }};">
        {{ section.settings.primary_button_text }}
      </a>
      <a href="{{ section.settings.secondary_button_link }}" class="joule-btn joule-btn--secondary joule-btn--m tap-target" style="background-color: {{ section.settings.secondary_button_color }}; color: {{ section.settings.secondary_button_text_color }}; border: 2px solid #000035;">
        {{ section.settings.secondary_button_text }}
      </a>
    </div>

  </div>
</section>

<style>
.joule-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 60px;
  height: 70vh;
  min-height: 500px;
  max-height: 700px;
  box-sizing: border-box;
  padding-block: 40px;
  padding-inline: 80px;
}

.joule-hero__content {
  flex: 1.4;
  max-width: 800px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.joule-heading {
  font-size: 60px;
  font-weight: 700;
  margin-bottom: 20px;
}

.joule-hero__content p {
  font-size: 25px;
  line-height: 1.6;
  margin-bottom: 30px;
}

.joule-hero__buttons {
  display: flex;
  gap: 20px;
}

.joule-btn {
  padding: 12px 24px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: bold;
  transition: transform 0.2s ease;
}

.joule-btn:hover {
  transform: translateY(-3px);
}

.joule-btn--secondary {
  background-color: transparent;
  border: 2px solid;
}

.joule-hero__image {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 10px;
  box-sizing: border-box;
  height: 100%;
}

.joule-hero__image img {
  max-height: 100%;
  max-width: 100%;
  object-fit: contain;
}

@media (max-width: 768px) {
  .joule-hero {
    flex-direction: column;
    text-align: center;
    height: auto;
    padding: 40px 20px;
  }

  .joule-hero__content {
    max-width: 100%;
    align-items: center;
  }

  .joule-hero__buttons {
    justify-content: center;
    flex-wrap: wrap;
  }

  .joule-hero__image {
    justify-content: center;
    padding: 20px;
  }

  .joule-hero__image img {
    max-height: 70vh;
    max-width: 100%;
  }
}
</style>

<!-- Additional, scoped CSS for the mobile-only variant -->
<style>
/* ===== Mobile hero (scoped) ===== */
.joule-hero-m {
  min-height: 100svh;
  display: grid;
  align-items: center;
}

.joule-hero-m__inner {
  text-align: center;
}

.m-hero-img img {
  width: 100%;
  height: auto;
  max-height: 46vh;        /* show the pack above the fold */
  object-fit: contain;
}

.joule-hero-m__title {
  letter-spacing: -0.5px;
  margin: 8px 0 2px;
}

.joule-hero-m__sub {
  line-height: 1.45;
  margin: 4px 0 10px;
}

.joule-btn--m {
  width: 100%;
  border-radius: 999px;
  font-weight: 800;
}

@media (max-width: 749px) {
  .joule-hero-m__title {
    font-size: clamp(28px, 8.2vw, 36px);
    line-height: 1.12;
  }
}
/* Ensure the mobile variant never shows on desktop */
@media (min-width: 750px) {
  .joule-hero-m { display: none !important; }
}

/* Apply layout only on mobile */
@media (max-width: 749px) {
  .joule-hero-m { display: grid; }
}
/* Reduce bottom spacing for the mobile hero */
@media (max-width: 749px) {
  .joule-hero-m {
    padding-bottom: 12px !important; /* half of current spacing */
  }
  .joule-hero-m__inner {
    gap: 12px !important;
  }
  .m-hero-img img {
    margin-bottom: 8px;
  }
}

</style>
