<section class="why-joule-section" style="background-color: {{ section.settings.background_color }}; --section-text: {{ section.settings.text_color | default: '#000035' }}; color: var(--section-text);">
  <div class="why-joule__inner">
    <div class="why-joule__header-content">
      {% if section.settings.caption != blank %}
        <p class="caption-with-letter-spacing" style="font-size: {{ section.settings.caption_size }}px; color: {{ section.settings.subheading_color }};">
          {{ section.settings.caption }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="why-joule__heading" style="font-size: {{ section.settings.heading_size | default: 30 }}px;">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="why-joule__row">
      {% if section.settings.main_image != blank %}
        <div class="why-joule__left">
          <img src="{{ section.settings.main_image | image_url: width: 800 }}" alt="Why Joule" loading="lazy" class="why-joule__image scroll-fade">
        </div>
      {% endif %}

      <div class="why-joule__right">
        <div class="why-joule__benefits">
          {% for block in section.blocks %}
            {% assign icon_1 = block.settings.icon %}
            {% assign icon_2 = block.settings.icon_2 %}

            <div class="why-joule__box"
                 style="background-color: {{ block.settings.box_color }};"
                 role="button" tabindex="0" aria-expanded="false">
              {% if icon_1 or icon_2 %}
                <div class="why-joule__icons {% unless icon_2 %}single-icon{% endunless %}">
                  {% if icon_1 %}
                    <img src="{{ icon_1 | image_url: width: 64 }}" class="why-joule__icon" alt="Icon 1">
                  {% endif %}
                  {% if icon_2 %}
                    <img src="{{ icon_2 | image_url: width: 64 }}" class="why-joule__icon" alt="Icon 2">
                  {% endif %}
                </div>
              {% endif %}
              <h3 class="why-joule__title">{{ block.settings.heading }}</h3>
              <p class="why-joule__text">{{ block.settings.subheading }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.why-joule-section { padding: 40px 0; color: var(--section-text) !important; }
.why-joule__inner { max-width: 1255px; margin: 0 auto; padding: 0 0rem; }
.why-joule__header-content { text-align: center; margin-bottom: 3rem; max-width: 800px; margin-left: auto; margin-right: auto; color: var(--section-text) !important; }
.why-joule__heading { font-weight: 700; margin-bottom: 0.5rem; color: var(--section-text) !important; }

.why-joule__row { display: flex; flex-wrap: nowrap; gap: 2rem; align-items: stretch; }
.why-joule__left { flex: 0 0 50%; position: relative; z-index: 1; display: flex; justify-content: flex-end; align-items: center; }
.why-joule__right { flex: 0 0 60%; margin-left: -10%; position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; }

.why-joule__image { width: 100%; height: 100%; object-fit: cover; border-radius: 1rem; opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
.scroll-fade.scroll-in { opacity: 1; transform: translateY(0); }

.why-joule__benefits { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; width: 100%; max-width: 760px; margin-left: auto; }
.why-joule__box { border-radius: 1rem; padding: 1.5rem; box-shadow: 0 0 0 transparent; transition: all 0.3s ease; text-align: center; color: var(--section-text) !important; }
.why-joule__box:hover { box-shadow: 0 10px 20px rgba(0,0,0,0.1); transform: translateY(-5px); }
.why-joule__icons { display: flex; justify-content: center; gap: 1rem; margin-bottom: 1rem; }
.why-joule__icons.single-icon { justify-content: center; }
.why-joule__icon { height: 60px; }
.why-joule__title { font-weight: 600; margin-bottom: 0; color: var(--section-text) !important; }
.why-joule__text { line-height: 1.4; margin-top: 0.2rem; color: var(--section-text) !important; }

/* =========================
   MOBILE (≤ 749px)
   ========================= */
@media screen and (max-width: 749px) {
  .why-joule-section { padding: 24px 0; }
  .why-joule__header-content { margin-bottom: 16px; padding: 0 20px; }

  .caption-with-letter-spacing {
    font-size: clamp(14px, 4.3vw, 16px) !important;
    line-height: 1.45 !important;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .why-joule__heading {
    font-size: clamp(28px, 8.2vw, 36px) !important;
    line-height: 1.12 !important;
    margin: 4px 0 10px;
  }

  .why-joule__row { flex-direction: column; gap: 12px; }
  .why-joule__left, .why-joule__right { flex: 1 1 auto; max-width: 100%; margin: 0 auto; }
  .why-joule__image { max-height: 36vh; height: auto; object-fit: contain; border-radius: 12px; }

  .why-joule__benefits {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 0;
    margin: 0;
    width: 100vw; /* match full screen */
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  /* --- TILE (tight when closed, aligned center line) --- */
  .why-joule__box {
    position: relative;
    width: calc(100vw - 32px); /* ✅ full width minus 16px padding each side */
    max-width: none;
    margin: 0 auto;
    padding: 8px 40px 8px 14px;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-height: 44px;
    text-align: left !important;
    box-shadow: none !important;
    transition: none !important;
    flex-wrap: wrap; /* ✅ always wrap so width doesn’t change */
  }

  .why-joule__box:hover { box-shadow: none !important; transform: none !important; }

  /* Chevron: right, vertically centered */
  .why-joule__box::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 14px;
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
    opacity: .45;
    transition: transform .2s ease;
  }
  .why-joule__box.is-open::after { transform: translateY(-50%) rotate(225deg); }

  .why-joule__icons {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 28px;
  }
  .why-joule__icon { width: 24px; height: 24px; object-fit: contain; }

  .why-joule__title {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: clamp(16px, 4.2vw, 18px) !important;
    line-height: 1.2 !important;
  }

  /* Description */
  .why-joule__text {
    display: none;
    width: 100%;
    font-size: clamp(13px, 3.9vw, 15px);
    line-height: 1.35;
    margin-top: 8px;
  }
  .why-joule__box.is-open {
    align-items: flex-start;
  }
  .why-joule__box.is-open .why-joule__text {
    display: block;
  }
}

</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* Fade-in observer */
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('scroll-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.scroll-fade').forEach(el => observer.observe(el));

    /* Mobile expand/collapse for benefit boxes */
    const mq = window.matchMedia('(max-width: 749px)');
    function bindMobileToggles() {
      if (!mq.matches) return; // only on mobile
      document.querySelectorAll('.why-joule__box').forEach(box => {
        const toggle = () => {
          const open = box.classList.toggle('is-open');
          box.setAttribute('aria-expanded', String(open));
        };
        box.addEventListener('click', toggle);
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
        });
      });
    }
    bindMobileToggles();
  });
</script>

{% schema %}
{
  "name": "Why Joule",
  "settings": [
    { "type": "color", "id": "text_color", "label": "Default text color", "default": "#000035" },
    { "type": "color", "id": "subheading_color", "label": "Subheading text color", "default": "#000035" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Answers to the questions you didn’t even know you had." },
    { "type": "range", "id": "caption_size", "label": "Caption Font Size (px)", "min": 10, "max": 30, "step": 1, "default": 14 },
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Why Joule?" },
    { "type": "range", "id": "heading_size", "label": "Heading Font Size (px)", "min": 20, "max": 60, "step": 1, "default": 30 },
    { "type": "image_picker", "id": "main_image", "label": "Main Image" },
    { "type": "color", "id": "background_color", "label": "Section Background Color", "default": "#F9F9F9" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Box",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon Image 1" },
        { "type": "image_picker", "id": "icon_2", "label": "Icon Image 2" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Boost Energy" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Long-lasting fuel to power your day." },
        { "type": "color", "id": "box_color", "label": "Box Background Color", "default": "#FFFFFF" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Why Joule — Aligned" }]
}
{% endschema %}
