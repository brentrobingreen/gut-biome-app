<style>
  .zylla-benefits {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-light);
  }

  .zylla-benefits__inner {
    max-width: var(--zylla-max-width);
    margin: 0 auto;
  }

  .zylla-benefits__header {
    text-align: center;
    margin-bottom: 5.6rem;
  }

  .zylla-benefits__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--zylla-mid);
    margin: 0 0 1.6rem;
  }

  .zylla-benefits__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(2.8rem, 3.5vw, 4.4rem);
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0;
    line-height: 1.15;
  }

  .zylla-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3.2rem;
  }

  .zylla-benefit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
  }

  .zylla-benefit__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--zylla-radius-sm);
    background: var(--zylla-off-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .zylla-benefit__icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--zylla-black);
  }

  .zylla-benefit__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--zylla-black);
    letter-spacing: 0.01em;
    margin: 0;
  }

  .zylla-benefit__text {
    font-size: 1.4rem;
    color: var(--zylla-mid);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 767px) {
    .zylla-benefits__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.2rem 2.4rem;
    }
  }

  @media (max-width: 479px) {
    .zylla-benefits__grid { grid-template-columns: 1fr; }
  }
</style>

<section class="zylla-benefits">
  <div class="zylla-benefits__inner">

    <div class="zylla-benefits__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zylla-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="zylla-benefits__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="zylla-benefit" {{ block.shopify_attributes }}>
          <div class="zylla-benefit__icon">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13c0-7 7-11 7-11s7 4 7 11a7 7 0 0 1-7 7Z"/><path d="M11 20v-7"/></svg>
              {%- when 'bag' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {%- when 'flask' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22h12a2 2 0 0 0 1.68-3.09L14 9V3h1a1 1 0 0 0 0-2H9a1 1 0 0 0 0 2h1v6L5.32 18.91A2 2 0 0 0 6 22Z"/><line x1="6" y1="15" x2="18" y2="15"/></svg>
              {%- when 'refresh' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {%- endcase -%}
          </div>
          <p class="zylla-benefit__title">{{ block.settings.title }}</p>
          <p class="zylla-benefit__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why Zylla"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for real life."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",    "label": "Leaf (clean ingredients)" },
            { "value": "bag",     "label": "Bag (portable)" },
            { "value": "flask",   "label": "Flask (science)" },
            { "value": "refresh", "label": "Refresh (subscription)" },
            { "value": "star",    "label": "Star (quality)" },
            { "value": "check",   "label": "Checkmark" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "No fillers, no fluff. Every ingredient is there for a reason — and every dose actually works."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Clean Ingredients",
            "text": "No fillers, no fluff. Every ingredient is there for a reason — and every dose actually works."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "bag",
            "title": "Sachet Format",
            "text": "Tear, stir, done. Fits in your bag, not just your cupboard. Convenience with zero compromise."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "flask",
            "title": "Science-Backed",
            "text": "Every formula is built on peer-reviewed research, with dosages at levels that are proven to make a difference."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "refresh",
            "title": "Flexible Subscription",
            "text": "Subscribe to save 15% on every order. Skip, swap, or cancel anytime — no hoops, no penalties."
          }
        }
      ]
    }
  ]
}
{% endschema %}
