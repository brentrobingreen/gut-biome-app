<style>
  .zylla-pair {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-light);
  }

  .zylla-pair__inner {
    max-width: var(--zylla-max-width);
    margin: 0 auto;
  }

  .zylla-pair__header {
    margin-bottom: 4rem;
  }

  .zylla-pair__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--zylla-mid);
    margin: 0 0 1.6rem;
  }

  .zylla-pair__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(3rem, 3.5vw, 4.8rem);
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0;
    line-height: 1.1;
  }

  .zylla-pair__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .zylla-pair-card {
    border-radius: var(--zylla-radius-card);
    padding: 3.6rem 3.2rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    min-height: 280px;
  }

  .zylla-pair-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }

  .zylla-pair-card--creatine { background: linear-gradient(160deg, #d8ebf8 0%, #b3d4f0 100%); }
  .zylla-pair-card--sleep    { background: linear-gradient(160deg, #e8e3f5 0%, #d0c5ec 100%); }
  .zylla-pair-card--glow     { background: linear-gradient(160deg, #fae8e5 0%, #f2cbc6 100%); }
  .zylla-pair-card--fiber    { background: linear-gradient(160deg, #dff0e0 0%, #c1e0c4 100%); }
  .zylla-pair-card--energy   { background: linear-gradient(160deg, #fef6ce 0%, #fce97a 100%); }

  .zylla-pair-card__dot {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    margin-bottom: auto;
    flex-shrink: 0;
  }

  .zylla-pair-card--creatine .zylla-pair-card__dot { background: var(--zylla-creatine); }
  .zylla-pair-card--sleep    .zylla-pair-card__dot { background: var(--zylla-sleep); }
  .zylla-pair-card--glow     .zylla-pair-card__dot { background: var(--zylla-glow); }
  .zylla-pair-card--fiber    .zylla-pair-card__dot { background: var(--zylla-fiber); }
  .zylla-pair-card--energy   .zylla-pair-card__dot { background: var(--zylla-energy); }

  .zylla-pair-card__body {
    margin-top: 3.2rem;
  }

  .zylla-pair-card__name {
    font-family: var(--zylla-font-display);
    font-size: 2.4rem;
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0 0 0.8rem;
    line-height: 1.1;
  }

  .zylla-pair-card__tagline {
    font-size: 1.3rem;
    color: var(--zylla-mid);
    margin: 0 0 2rem;
    line-height: 1.5;
  }

  .zylla-pair-card__cta {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--zylla-black);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.6;
    transition: gap 0.2s, opacity 0.2s;
  }

  .zylla-pair-card:hover .zylla-pair-card__cta {
    gap: 1rem;
    opacity: 1;
  }

  @media (max-width: 767px) {
    .zylla-pair__grid {
      grid-template-columns: repeat(3, 280px);
      overflow-x: auto;
      padding-bottom: 1.6rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .zylla-pair__grid::-webkit-scrollbar { display: none; }
  }
</style>

<section class="zylla-pair">
  <div class="zylla-pair__inner">

    <div class="zylla-pair__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zylla-pair__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="zylla-pair__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-pair__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.url | default: '/collections/all' }}"
          class="zylla-pair-card zylla-pair-card--{{ block.settings.color_key }}"
          {{ block.shopify_attributes }}
        >
          <div class="zylla-pair-card__dot"></div>
          <div class="zylla-pair-card__body">
            <p class="zylla-pair-card__name">{{ block.settings.name }}</p>
            <p class="zylla-pair-card__tagline">{{ block.settings.tagline }}</p>
            <span class="zylla-pair-card__cta">Shop &rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pair It With",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Complete your routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair it with"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Product name",
          "default": "Sleep"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Wind down & restore"
        },
        {
          "type": "select",
          "id": "color_key",
          "label": "Accent colour",
          "options": [
            { "value": "creatine", "label": "Creatine (Blue)" },
            { "value": "sleep",    "label": "Sleep (Lavender)" },
            { "value": "glow",     "label": "Glow (Blush)" },
            { "value": "fiber",    "label": "Fiber (Green)" },
            { "value": "energy",   "label": "Energy (Yellow)" }
          ],
          "default": "sleep"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Product link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pair It With",
      "blocks": [
        { "type": "product", "settings": { "name": "Sleep",  "tagline": "Wind down & restore",    "color_key": "sleep" } },
        { "type": "product", "settings": { "name": "Glow",   "tagline": "Collagen from within",   "color_key": "glow" } },
        { "type": "product", "settings": { "name": "Fiber",  "tagline": "Gut health, simplified", "color_key": "fiber" } }
      ]
    }
  ]
}
{% endschema %}
