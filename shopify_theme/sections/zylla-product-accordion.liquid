<style>
  .zylla-accordion {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-off-white);
  }

  .zylla-accordion__inner {
    max-width: var(--zylla-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 8rem;
    align-items: start;
  }

  .zylla-accordion__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--zylla-mid);
    margin: 0 0 1.6rem;
  }

  .zylla-accordion__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(3rem, 3.5vw, 4.8rem);
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0;
    line-height: 1.1;
  }

  .zylla-accordion__list {
    border-top: 1px solid var(--zylla-border);
  }

  details.zylla-accordion__item {
    border-bottom: 1px solid var(--zylla-border);
  }

  details.zylla-accordion__item summary {
    list-style: none;
    width: 100%;
    padding: 2.4rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    cursor: pointer;
  }

  details.zylla-accordion__item summary::-webkit-details-marker { display: none; }

  .zylla-accordion__trigger-left {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .zylla-accordion__icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--zylla-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .zylla-accordion__icon svg {
    width: 18px;
    height: 18px;
    stroke: var(--zylla-black);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .zylla-accordion__title {
    font-family: var(--zylla-font-display);
    font-size: 2rem;
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0;
  }

  .zylla-accordion__chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
    color: var(--zylla-mid);
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  details[open].zylla-accordion__item .zylla-accordion__chevron {
    transform: rotate(180deg);
  }

  .zylla-accordion__body {
    padding: 0 0 2.8rem 5.6rem;
    font-size: 1.5rem;
    line-height: 1.8;
    color: var(--zylla-mid);
    max-width: 520px;
  }

  .zylla-accordion__body p { margin: 0; }
  .zylla-accordion__body p + p { margin-top: 1.2rem; }

  @media (max-width: 767px) {
    .zylla-accordion__inner { grid-template-columns: 1fr; gap: 3.2rem; }
    .zylla-accordion__heading { font-size: clamp(2.6rem, 8vw, 3.6rem); }
    details.zylla-accordion__item summary { padding: 2rem 0; }
    .zylla-accordion__icon { width: 36px; height: 36px; }
    .zylla-accordion__title { font-size: 1.8rem; }
    .zylla-accordion__body { padding-left: 0; font-size: 1.4rem; }
  }
</style>

<section class="zylla-accordion">
  <div class="zylla-accordion__inner">

    <div class="zylla-accordion__left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zylla-accordion__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="zylla-accordion__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-accordion__list">
      {%- for block in section.blocks -%}
        <details class="zylla-accordion__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span class="zylla-accordion__trigger-left">
              <span class="zylla-accordion__icon">
                {%- case block.settings.icon -%}
                  {%- when 'flask' -%}
                    <svg viewBox="0 0 24 24"><path d="M9 3h6M9 3v7l-5 9a1 1 0 0 0 .9 1.5h14.2A1 1 0 0 0 20 19l-5-9V3"/><line x1="6.5" y1="14.5" x2="17.5" y2="14.5"/></svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 19.57A1 1 0 0 0 4.7 21 23.5 23.5 0 0 0 20 18c1-6-2-13-3-10z"/><path d="M3.82 19.57l5.68-5.68"/></svg>
                  {%- when 'use' -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
                {%- endcase -%}
              </span>
              <h3 class="zylla-accordion__title">{{ block.settings.heading }}</h3>
            </span>
            <svg class="zylla-accordion__chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="zylla-accordion__body">
            {{ block.settings.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Everything you need to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Details"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flask",  "label": "Flask (Ingredients)" },
            { "value": "use",    "label": "Clock (How to Use)" },
            { "value": "leaf",   "label": "Leaf (Natural)" },
            { "value": "check",  "label": "Check (Benefits)" },
            { "value": "star",   "label": "Star (Why Zylla)" }
          ],
          "default": "flask"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What's Inside"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Each sachet contains clinically-dosed, research-backed ingredients with no fillers and nothing your body doesn't need.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Accordion",
      "blocks": [
        { "type": "item", "settings": { "icon": "flask", "heading": "What's Inside", "content": "<p>Each sachet contains clinically-dosed, research-backed ingredients with no fillers, no artificial colours, and nothing your body doesn't need.</p>" } },
        { "type": "item", "settings": { "icon": "use",   "heading": "How to Use",    "content": "<p>Mix one sachet with 200–300ml of cold water and drink. Best taken in the morning or before exercise. Suitable for daily use.</p>" } },
        { "type": "item", "settings": { "icon": "leaf",  "heading": "Why Zylla",     "content": "<p>Vegan, gluten-free, and made without artificial sweeteners. Formulated for busy people who take their health seriously.</p>" } }
      ]
    }
  ]
}
{% endschema %}
