<style>
  .zylla-benefits {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-off-white);
  }

  .zylla-benefits__inner { max-width: var(--zylla-max-width); margin: 0 auto; }

  .zylla-benefits__header { text-align: center; margin-bottom: 5.6rem; }

  .zylla-benefits__eyebrow {
    font-size: 1.1rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--zylla-mid); margin: 0 0 1.6rem;
  }

  .zylla-benefits__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(3rem, 3.5vw, 4.8rem);
    font-weight: 400; color: var(--zylla-black); margin: 0; line-height: 1.1;
  }

  .zylla-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .zylla-benefit-card {
    background: #fff;
    border-radius: var(--zylla-radius-card);
    padding: 3.2rem 2.8rem;
  }

  .zylla-benefit-card__icon-wrap {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: var(--zylla-benefits-accent, var(--zylla-black));
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 2.4rem;
  }

  .zylla-benefit-card__icon-wrap svg {
    width: 26px; height: 26px;
    stroke: var(--zylla-benefits-accent-text, #fff);
    fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }

  .zylla-benefit-card__title {
    font-family: var(--zylla-font-display);
    font-size: 2.2rem; font-weight: 400; color: var(--zylla-black);
    margin: 0 0 1rem; line-height: 1.1;
  }

  .zylla-benefit-card__text {
    font-size: 1.4rem; color: var(--zylla-mid); line-height: 1.75; margin: 0;
  }

  @media (max-width: 899px) { .zylla-benefits__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 479px) { .zylla-benefits__grid { grid-template-columns: 1fr; } }
</style>

<section
  class="zylla-benefits"
  style="--zylla-benefits-accent: {{ section.settings.accent_color }}; --zylla-benefits-accent-text: {{ section.settings.accent_text_color }};"
>
  <div class="zylla-benefits__inner">

    <div class="zylla-benefits__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zylla-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="zylla-benefits__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="zylla-benefit-card" {{ block.shopify_attributes }}>
          <div class="zylla-benefit-card__icon-wrap">
            {%- case block.settings.icon -%}
              {%- when 'lightning' -%}
                <svg viewBox="0 0 24 24"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 19.57A1 1 0 0 0 4.7 21 23.5 23.5 0 0 0 20 18c1-6-2-13-3-10z"/><path d="M3.82 19.57l5.68-5.68"/></svg>
              {%- when 'moon' -%}
                <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              {%- when 'sun' -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              {%- when 'activity' -%}
                <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when 'flask' -%}
                <svg viewBox="0 0 24 24"><path d="M9 3h6M9 3v7l-5 9a1 1 0 0 0 .9 1.5h14.2A1 1 0 0 0 20 19l-5-9V3"/><line x1="6.5" y1="14.5" x2="17.5" y2="14.5"/></svg>
              {%- when 'droplet' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
              {%- when 'refresh' -%}
                <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {%- endcase -%}
          </div>
          <h3 class="zylla-benefit-card__title">{{ block.settings.title }}</h3>
          <p class="zylla-benefit-card__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "settings": [
    { "type": "text",  "id": "eyebrow",           "label": "Eyebrow text",        "default": "Why it works" },
    { "type": "text",  "id": "heading",            "label": "Heading",             "default": "Built to perform" },
    { "type": "color", "id": "accent_color",       "label": "Icon accent colour",  "default": "#4B8FD4" },
    { "type": "color", "id": "accent_text_color",  "label": "Text on icon",        "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "lightning", "label": "Lightning / Energy" },
            { "value": "leaf",      "label": "Leaf / Natural" },
            { "value": "moon",      "label": "Moon / Sleep" },
            { "value": "sun",       "label": "Sun / Morning" },
            { "value": "activity",  "label": "Activity / Performance" },
            { "value": "heart",     "label": "Heart / Skin" },
            { "value": "star",      "label": "Star / Quality" },
            { "value": "shield",    "label": "Shield / Immunity" },
            { "value": "flask",     "label": "Flask / Science" },
            { "value": "droplet",   "label": "Droplet / Hydration" },
            { "value": "refresh",   "label": "Refresh / Recovery" }
          ],
          "default": "lightning"
        },
        { "type": "text",     "id": "title", "label": "Title",       "default": "Muscle Strength" },
        { "type": "textarea", "id": "text",  "label": "Description", "default": "Supports ATP production to increase peak power output and strength over time." }
      ]
    }
  ],
  "presets": [{ "name": "Product Benefits" }]
}
{% endschema %}
