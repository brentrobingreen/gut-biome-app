<style>
  .zylla-reviews {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-light);
  }

  .zylla-reviews__inner { max-width: var(--zylla-max-width); margin: 0 auto; }

  .zylla-reviews__header { text-align: center; margin-bottom: 4rem; }

  .zylla-reviews__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(2.8rem, 3.5vw, 4.4rem);
    font-weight: 400; color: var(--zylla-black); margin: 0; line-height: 1.1;
  }

  .zylla-reviews__track-wrap { position: relative; }

  .zylla-reviews__track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.4rem;
    -webkit-overflow-scrolling: touch;
  }

  .zylla-reviews__track::-webkit-scrollbar { display: none; }

  .zylla-review-card {
    flex: 0 0 calc(33.333% - 1.4rem);
    scroll-snap-align: start;
    background: #fff;
    border-radius: var(--zylla-radius-card);
    padding: 3.2rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 280px;
  }

  .zylla-review-card__stars { display: flex; gap: 3px; }
  .zylla-review-card__stars svg { width: 14px; height: 14px; }

  .zylla-review-card__quote {
    font-size: 1.45rem;
    line-height: 1.75;
    color: var(--zylla-black);
    flex: 1;
    font-style: italic;
    margin: 0;
  }

  .zylla-review-card__author { display: flex; align-items: center; gap: 1.2rem; }

  .zylla-review-card__avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--zylla-reviews-accent, var(--zylla-black));
    color: var(--zylla-reviews-accent-text, #fff);
    font-family: var(--zylla-font-display);
    font-size: 1.7rem;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .zylla-review-card__name { font-size: 1.3rem; font-weight: 700; color: var(--zylla-black); margin: 0; }
  .zylla-review-card__role { font-size: 1.2rem; color: var(--zylla-mid); margin: 0; }

  /* Navigation */
  .zylla-reviews__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-top: 3.2rem;
  }

  .zylla-reviews__nav-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--zylla-border);
    background: #fff;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    flex-shrink: 0;
  }

  .zylla-reviews__nav-btn:hover { border-color: var(--zylla-black); background: var(--zylla-black); }
  .zylla-reviews__nav-btn:hover svg { stroke: #fff; }

  .zylla-reviews__nav-btn svg { width: 18px; height: 18px; stroke: var(--zylla-black); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .zylla-reviews__dots { display: flex; gap: 0.8rem; align-items: center; }

  .zylla-reviews__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(26,26,26,0.2);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.15s, transform 0.15s;
  }

  .zylla-reviews__dot.is-active { background: var(--zylla-black); transform: scale(1.3); }

  @media (max-width: 767px) {
    .zylla-reviews { padding: var(--zylla-section-gap) 0; }
    .zylla-reviews__inner { padding: 0 var(--zylla-gutter); }
    .zylla-reviews__track { padding-left: var(--zylla-gutter); padding-right: var(--zylla-gutter); }
    .zylla-reviews__header { padding: 0; margin-bottom: 3rem; }
    .zylla-reviews__heading { font-size: clamp(2.4rem, 8vw, 3.6rem); }
    .zylla-review-card { flex: 0 0 85vw; padding: 2.4rem 2.2rem; }
    .zylla-review-card__quote { font-size: 1.35rem; }
    .zylla-reviews__nav { margin-top: 2.4rem; }
  }
</style>

<section
  class="zylla-reviews"
  style="--zylla-reviews-accent: {{ section.settings.accent_color }}; --zylla-reviews-accent-text: {{ section.settings.accent_text_color }};"
  id="zylla-reviews-{{ section.id }}"
>
  <div class="zylla-reviews__inner">

    <div class="zylla-reviews__header">
      <h2 class="zylla-reviews__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-reviews__track-wrap">
      <div class="zylla-reviews__track" id="zylla-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="zylla-review-card" {{ block.shopify_attributes }}>
            <div class="zylla-review-card__stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" fill="{{ section.settings.accent_color }}">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {%- endfor -%}
            </div>
            <p class="zylla-review-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <div class="zylla-review-card__author">
              <div class="zylla-review-card__avatar">{{ block.settings.name | slice: 0 }}</div>
              <div>
                <p class="zylla-review-card__name">{{ block.settings.name }}</p>
                {%- if block.settings.role != blank -%}
                  <p class="zylla-review-card__role">{{ block.settings.role }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="zylla-reviews__nav">
      <button class="zylla-reviews__nav-btn" id="zylla-prev-{{ section.id }}" aria-label="Previous reviews" type="button">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="zylla-reviews__dots" id="zylla-dots-{{ section.id }}"></div>
      <button class="zylla-reviews__nav-btn" id="zylla-next-{{ section.id }}" aria-label="Next reviews" type="button">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

  </div>
</section>

<script>
(function () {
  var sid    = '{{ section.id }}';
  var track  = document.getElementById('zylla-track-' + sid);
  var dotsEl = document.getElementById('zylla-dots-' + sid);
  var prevBtn = document.getElementById('zylla-prev-' + sid);
  var nextBtn = document.getElementById('zylla-next-' + sid);

  if (!track) return;

  var cards    = track.querySelectorAll('.zylla-review-card');
  var total    = cards.length;
  var perPage  = window.innerWidth < 768 ? 1 : 3;
  var pages    = Math.ceil(total / perPage);
  var current  = 0;
  var timer;

  function buildDots() {
    dotsEl.innerHTML = '';
    for (var i = 0; i < pages; i++) {
      var dot = document.createElement('button');
      dot.className = 'zylla-reviews__dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
      dot.setAttribute('type', 'button');
      dot.dataset.page = i;
      dot.addEventListener('click', function () { goTo(parseInt(this.dataset.page)); });
      dotsEl.appendChild(dot);
    }
  }

  function goTo(page) {
    current = (page + pages) % pages;
    var card = cards[current * perPage];
    if (card) track.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
    dotsEl.querySelectorAll('.zylla-reviews__dot').forEach(function (d, i) {
      d.classList.toggle('is-active', i === current);
    });
    resetTimer();
  }

  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(function () { goTo(current + 1); }, 5000);
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });

  buildDots();
  resetTimer();
})();
</script>

{% schema %}
{
  "name": "Reviews Carousel",
  "settings": [
    { "type": "text",  "id": "heading",           "label": "Heading",              "default": "What our customers say" },
    { "type": "color", "id": "accent_color",       "label": "Star & avatar colour", "default": "#4B8FD4" },
    { "type": "color", "id": "accent_text_color",  "label": "Text on avatar",       "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review quote",          "default": "This product genuinely changed my routine. I take it every single day." },
        { "type": "text",     "id": "name",  "label": "Customer name",         "default": "Sarah L." },
        { "type": "text",     "id": "role",  "label": "Customer title / role", "default": "Personal Trainer" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews Carousel" }]
}
{% endschema %}
