<style>
  .zylla-testimonials {
    padding: var(--zylla-section-gap) var(--zylla-gutter);
    background: var(--zylla-off-white);
  }

  .zylla-testimonials__inner {
    max-width: var(--zylla-max-width);
    margin: 0 auto;
  }

  .zylla-testimonials__header {
    text-align: center;
    margin-bottom: 5.6rem;
  }

  .zylla-testimonials__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--zylla-mid);
    margin: 0 0 1.6rem;
  }

  .zylla-testimonials__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(2.8rem, 3.5vw, 4.4rem);
    font-weight: 400;
    color: var(--zylla-black);
    margin: 0;
    line-height: 1.15;
  }

  .zylla-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
  }

  .zylla-testimonial-card {
    background: var(--zylla-light);
    border-radius: var(--zylla-radius-card);
    padding: 3.2rem;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .zylla-testimonial-card__stars {
    display: flex;
    gap: 4px;
    color: var(--zylla-energy);
    font-size: 1.6rem;
    letter-spacing: 2px;
  }

  .zylla-testimonial-card__quote {
    font-size: 1.6rem;
    line-height: 1.65;
    color: var(--zylla-black);
    margin: 0;
    flex: 1;
  }

  .zylla-testimonial-card__author {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: auto;
  }

  .zylla-testimonial-card__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--zylla-black);
    color: #fff;
    font-size: 1.4rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--zylla-font-body);
  }

  .zylla-testimonial-card__name {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--zylla-black);
    margin: 0 0 0.3rem;
  }

  .zylla-testimonial-card__role {
    font-size: 1.2rem;
    color: var(--zylla-mid);
    margin: 0;
  }

  @media (max-width: 767px) {
    .zylla-testimonials__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }
</style>

<section class="zylla-testimonials">
  <div class="zylla-testimonials__inner">

    <div class="zylla-testimonials__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zylla-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="zylla-testimonials__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="zylla-testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="zylla-testimonial-card" {{ block.shopify_attributes }}>
          <div class="zylla-testimonial-card__stars" aria-label="5 stars">★★★★★</div>
          <p class="zylla-testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <div class="zylla-testimonial-card__author">
            <div class="zylla-testimonial-card__avatar" aria-hidden="true">
              {{ block.settings.name | slice: 0 }}
            </div>
            <div>
              <p class="zylla-testimonial-card__name">{{ block.settings.name }}</p>
              <p class="zylla-testimonial-card__role">{{ block.settings.role }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Real Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What people are saying."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I've tried every supplement brand out there. Zylla is the first one that actually fits into my morning routine without any fuss."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / label",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "I've tried every supplement brand out there. Zylla is the first one that actually fits into my morning routine without any fuss.",
            "name": "Sarah M.",
            "role": "Verified Customer · Sydney"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The energy sachet is unreal. Clean focus without the crash. My 3pm slump is completely gone and I haven't looked back.",
            "name": "James T.",
            "role": "Verified Customer · Melbourne"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Subscribe & save is a no-brainer. Set it and forget it — it just shows up every month. Never run out, never overpay.",
            "name": "Priya K.",
            "role": "Verified Customer · Brisbane"
          }
        }
      ]
    }
  ]
}
{% endschema %}
