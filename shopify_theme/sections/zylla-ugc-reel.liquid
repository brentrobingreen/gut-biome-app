<style>
  .zylla-ugc {
    padding: var(--zylla-section-gap) 0;
    background: #0A0A0A;
    overflow: hidden;
  }

  .zylla-ugc__header {
    padding: 0 var(--zylla-gutter);
    max-width: var(--zylla-max-width);
    margin: 0 auto 4rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .zylla-ugc__header-left { flex: 1; }

  .zylla-ugc__eyebrow {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin: 0 0 1.2rem;
  }

  .zylla-ugc__heading {
    font-family: var(--zylla-font-display);
    font-size: clamp(2.8rem, 3.5vw, 4.4rem);
    font-weight: 400;
    color: #fff;
    margin: 0 0 1rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .zylla-ugc__subtext {
    font-size: 1.45rem;
    color: rgba(255,255,255,0.5);
    margin: 0;
    line-height: 1.5;
    max-width: 48ch;
  }

  /* Social handles */
  .zylla-ugc__header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.2rem;
    flex-shrink: 0;
  }

  .zylla-ugc__socials {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .zylla-ugc__social-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 600;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--zylla-radius-pill);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .zylla-ugc__social-link:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.06);
  }

  .zylla-ugc__social-link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Nav arrows */
  .zylla-ugc__nav {
    display: flex;
    gap: 0.8rem;
  }

  .zylla-ugc__nav-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .zylla-ugc__nav-btn:hover {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.3);
  }

  .zylla-ugc__nav-btn svg {
    width: 18px;
    height: 18px;
    stroke: rgba(255,255,255,0.8);
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Track */
  .zylla-ugc__track-wrap {
    position: relative;
  }

  .zylla-ugc__track-wrap::before,
  .zylla-ugc__track-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8rem;
    z-index: 2;
    pointer-events: none;
  }

  .zylla-ugc__track-wrap::before {
    left: 0;
    background: linear-gradient(to right, #0A0A0A, transparent);
  }

  .zylla-ugc__track-wrap::after {
    right: 0;
    background: linear-gradient(to left, #0A0A0A, transparent);
  }

  .zylla-ugc__track {
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 var(--zylla-gutter) 0.4rem;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }

  .zylla-ugc__track::-webkit-scrollbar { display: none; }
  .zylla-ugc__track.is-dragging { cursor: grabbing; user-select: none; }

  /* Reel card */
  .zylla-ugc__reel {
    flex-shrink: 0;
    width: 270px;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    background: #1c1c1c;
  }

  .zylla-ugc__reel video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zylla-ugc__reel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder */
  .zylla-ugc__reel-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #1c1c1c, #2a2a2a);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zylla-ugc__reel-placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.15;
    stroke: #fff;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Play icon overlay (for image-only cards) */
  .zylla-ugc__reel-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .zylla-ugc__reel-play svg {
    width: 18px;
    height: 18px;
    fill: #fff;
    margin-left: 3px;
  }

  /* Caption overlay */
  .zylla-ugc__reel-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 5rem 1.4rem 1.6rem;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
  }

  .zylla-ugc__reel-user {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.6rem;
  }

  .zylla-ugc__reel-avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 1.5px solid rgba(255,255,255,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    text-transform: uppercase;
  }

  .zylla-ugc__reel-username {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
  }

  .zylla-ugc__reel-caption {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .zylla-ugc__header { flex-direction: column; align-items: flex-start; }
    .zylla-ugc__header-right { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
  }

  @media (max-width: 767px) {
    .zylla-ugc__reel { width: 230px; }
    .zylla-ugc__track-wrap::before,
    .zylla-ugc__track-wrap::after { width: 4rem; }
  }
</style>

<section class="zylla-ugc">

  <div class="zylla-ugc__header">
    <div class="zylla-ugc__header-left">
      <p class="zylla-ugc__eyebrow">Real People. Real Results.</p>
      <h2 class="zylla-ugc__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="zylla-ugc__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="zylla-ugc__header-right">
      <div class="zylla-ugc__socials">
        <!-- Instagram -->
        <a href="https://instagram.com/zylla" target="_blank" rel="noopener" class="zylla-ugc__social-link" aria-label="Follow Zylla on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          @zylla
        </a>
        <!-- TikTok -->
        <a href="https://tiktok.com/@zylla" target="_blank" rel="noopener" class="zylla-ugc__social-link" aria-label="Follow Zylla on TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.78a4.85 4.85 0 0 1-1.01-.09z"/>
          </svg>
          @zylla
        </a>
      </div>

      <div class="zylla-ugc__nav">
        <button class="zylla-ugc__nav-btn" id="ugc-prev-{{ section.id }}" aria-label="Previous">
          <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="zylla-ugc__nav-btn" id="ugc-next-{{ section.id }}" aria-label="Next">
          <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="zylla-ugc__track-wrap">
    <div class="zylla-ugc__track" id="ugc-track-{{ section.id }}">

      {%- for block in section.blocks -%}
        {%- if block.type == 'reel' -%}
          <div class="zylla-ugc__reel" {{ block.shopify_attributes }}>

            {%- if block.settings.video != blank -%}
              {{- block.settings.video | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  poster: block.settings.poster | image_url: width: 600
              -}}
            {%- elsif block.settings.poster != blank -%}
              <img
                src="{{ block.settings.poster | image_url: width: 600 }}"
                alt="{{ block.settings.poster.alt | default: block.settings.username | escape }}"
                loading="lazy"
                class="zylla-ugc__reel-img"
              >
              <div class="zylla-ugc__reel-play">
                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </div>
            {%- else -%}
              <div class="zylla-ugc__reel-placeholder">
                <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </div>
            {%- endif -%}

            {%- if block.settings.username != blank or block.settings.caption != blank -%}
              <div class="zylla-ugc__reel-overlay">
                {%- if block.settings.username != blank -%}
                  <div class="zylla-ugc__reel-user">
                    <div class="zylla-ugc__reel-avatar">{{ block.settings.username | slice: 0 }}</div>
                    <span class="zylla-ugc__reel-username">@{{ block.settings.username }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="zylla-ugc__reel-caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>

</section>

<script>
(function () {
  var track = document.getElementById('ugc-track-{{ section.id }}');
  var prevBtn = document.getElementById('ugc-prev-{{ section.id }}');
  var nextBtn = document.getElementById('ugc-next-{{ section.id }}');
  if (!track) return;

  var cardW = function () {
    var first = track.querySelector('.zylla-ugc__reel');
    return first ? first.offsetWidth + 14 : 284;
  };

  if (nextBtn) nextBtn.addEventListener('click', function () {
    track.scrollBy({ left: cardW() * 2, behavior: 'smooth' });
  });
  if (prevBtn) prevBtn.addEventListener('click', function () {
    track.scrollBy({ left: -cardW() * 2, behavior: 'smooth' });
  });

  /* Drag to scroll */
  var startX, startLeft, dragging = false;
  track.addEventListener('mousedown', function (e) {
    dragging = true;
    startX = e.pageX;
    startLeft = track.scrollLeft;
    track.classList.add('is-dragging');
  });
  document.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    track.scrollLeft = startLeft - (e.pageX - startX);
  });
  document.addEventListener('mouseup', function () {
    dragging = false;
    track.classList.remove('is-dragging');
  });
})();
</script>

{% schema %}
{
  "name": "UGC Reel",
  "settings": [
    { "type": "text",     "id": "heading", "label": "Heading",    "default": "From the Zylla community." },
    { "type": "textarea", "id": "subtext", "label": "Subheading", "default": "Real customers. Real routines. Tag us @zylla to be featured." }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video",        "id": "video",    "label": "Video (optional)" },
        { "type": "image_picker", "id": "poster",   "label": "Cover image / poster" },
        { "type": "text",         "id": "username", "label": "Instagram username (without @)", "default": "customer" },
        { "type": "textarea",     "id": "caption",  "label": "Caption", "default": "This is exactly what my routine was missing. #zylla" }
      ]
    }
  ],
  "presets": [{ "name": "UGC Reel" }]
}
{% endschema %}
